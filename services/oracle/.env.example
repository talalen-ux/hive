# Anthropic API key — used to call Claude for idea generation.
# Generate at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# RPC endpoint for the chain HiveGovernor lives on.
# mainnet: https://mainnet.infura.io/v3/<KEY> or https://eth-mainnet.g.alchemy.com/v2/<KEY>
# sepolia: https://sepolia.infura.io/v3/<KEY>
RPC_URL=

# Chain ID. 1 for mainnet, 11155111 for sepolia.
CHAIN_ID=1

# Address of the deployed HiveGovernor contract (printed by scripts/deploy.ts).
GOVERNOR_ADDRESS=0x...

# Private key of the oracle EOA. Must match HiveGovernor.oracle().
# Treat as a secret. Use a key manager / GitHub Actions secrets in production.
ORACLE_PRIVATE_KEY=0x...

# How many ideas to generate per run. The oracle will skip duplicates of the
# last 20 on-chain proposals so this is a soft target, not a guarantee.
IDEAS_PER_RUN=5

# Voting window for new proposals, in hours. Must be in [24, 168].
VOTING_WINDOW_HOURS=48

# Set to "true" to skip the on-chain createProposal call and just print
# what would be posted. Useful for first-run smoke tests and CI dry-runs.
DRY_RUN=false
